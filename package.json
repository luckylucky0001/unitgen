{
  "name": "unitgen",
  "version": "0.1.0",
  "description": "Coverage-guided unit test backfilling for iOS (Swift), Android (Kotlin/Java) and HarmonyOS (ArkTS)",
  "type": "module",
  "bin": {
    "unitgen": "bin/unitgen"
  },
  "engines": {
    "node": ">=22.18"
  },
  "scripts": {
    "typecheck": "tsc -p .",
    "test": "node --disable-warning=ExperimentalWarning --test test/*.test.ts"
  },
  "license": "MIT",
  "devDependencies": {
    "@types/node": "^22.10.0"
  },
  "dependencies": {
    "c8": "^10.1.2",
    "typescript": "^5.6.3"
  }
}
